{
  "version": 3,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "macOS (testing)",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vita",
      "displayName": "PS Vita",
      "binaryDir": "${sourceDir}/build/vita",
      "toolchainFile": "$env{VITASDK}/share/vita.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vita-background",
      "displayName": "PS Vita (experimental background music)",
      "inherits": "vita",
      "binaryDir": "${sourceDir}/build/vita-background",
      "cacheVariables": {
        "SIENNA_VITA_BACKGROUND": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "vita", "configurePreset": "vita" },
    { "name": "vita-background", "configurePreset": "vita-background" }
  ]
}
